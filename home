<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BMP - Metro Project</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@200;300;400;900&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Montserrat', sans-serif; background-color: #f7f7f9; }
        h1, h2, h3, .font-black { font-weight: 900; }
        .font-light { font-weight: 300; }
        
        .page-transition { animation: fadeIn 0.5s ease-out forwards; }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .fade-up {
            opacity: 0;
            transform: translateY(30px);
            transition: opacity 0.6s ease-out, transform 0.6s ease-out;
        }
        .fade-up.visible { opacity: 1; transform: translateY(0); }
        
        .metro-card { transition: transform 0.2s ease, box-shadow 0.2s ease; }
        .metro-card:hover { transform: translateY(-4px); box-shadow: 0 10px 25px rgba(0,0,0,0.08); }
        .metro-card:hover .arrow-icon { transform: translateX(4px); background-color: #ef4444; color: white; }
    </style>
</head>
<body class="text-gray-900 flex flex-col min-h-screen">

    <header class="w-full bg-white flex justify-between items-center py-4 px-8 sticky top-0 z-50 border-b border-gray-100">
        <a href="index.html" class="flex items-center gap-3 cursor-pointer">
            <img src="Plugin icon - 1.png" alt="BMP Logo" class="w-10 h-10 rounded-full">
            <span class="font-black text-xl tracking-wide">BMP</span>
        </a>
        <nav class="hidden md:flex gap-8 text-sm font-medium text-gray-700">
            <a href="index.html" class="text-red-500 transition-colors">Дом</a>
            <a href="development.html" class="hover:text-red-500 transition-colors">Разработка</a>
            <a href="map.html" class="hover:text-red-500 transition-colors">Маршруты</a>
            <div class="relative group cursor-pointer">
                <span class="hover:text-red-500 transition-colors flex items-center gap-1">Работа <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg></span>
                <div class="absolute left-0 mt-4 w-40 bg-white border border-gray-100 shadow-xl rounded-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all">
                    <a href="vacancies.html" class="block px-5 py-3 hover:bg-gray-50 rounded-xl hover:text-red-500">Вакансии</a>
                </div>
            </div>
            <a href="documents.html" class="hover:text-red-500 transition-colors">Документы</a>
            <a href="links.html" class="hover:text-red-500 transition-colors">Ссылки</a>
            <a href="team.html" class="hover:text-red-500 transition-colors">Команда</a>
            <a href="photos.html" class="hover:text-red-500 transition-colors">Фотографии</a>
        </nav>
    </header>

    <main class="flex-grow flex flex-col items-center px-4 py-16 w-full max-w-6xl mx-auto page-transition">
        
        <div class="text-center mb-16 fade-up">
            <h1 class="text-4xl md:text-6xl font-black mb-6">BMP - Metro Project</h1>
            <p class="max-w-3xl mx-auto text-gray-600 leading-relaxed">
                Игра про выдуманную систему метрополитена в выдуманном городе Берёзовецк, который находится в России. Сама игра находится в разработке, официальное открытие планируется до конца января 2027 года.
            </p>
        </div>

        <!-- Переделанная 6-колоночная сетка для гибкости -->
        <div class="w-full grid grid-cols-1 md:grid-cols-6 gap-6 fade-up" style="transition-delay: 0.1s;">
            
            <!-- Карточка: Схема метро (теперь занимает 3 колонки из 6, то есть 50%) -->
            <a href="map.html" class="md:col-span-3 bg-white rounded-[2rem] p-8 shadow-sm metro-card group block">
                <h2 class="text-2xl font-black mb-6">Схема метро</h2>
                <div class="w-full h-64 md:h-96 rounded-2xl overflow-hidden relative border-2 border-gray-100 group-hover:border-red-200 transition-colors bg-gray-50 flex items-center justify-center">
                    <img src="map-preview.png" alt="Схема метро Берёзовецка" class="w-full h-full object-cover object-center">
                </div>
            </a>

            <!-- Карточка: Новости (тоже занимает 3 колонки из 6, то есть 50%) -->
            <div class="md:col-span-3 bg-white rounded-[2rem] border-2 border-gray-100 overflow-hidden shadow-sm flex flex-col metro-card h-auto md:h-auto min-h-[400px]">
                <div class="bg-gray-50 py-5 px-8 border-b border-gray-100">
                    <h2 class="text-2xl font-black">Новости</h2>
                </div>
                <iframe src="https://docs.google.com/document/d/15yLtSBMNVcQbilHOL9pXFbUMtX61H4Y0a_M9yjrL5Rw/preview" class="w-full flex-grow border-0 min-h-[300px]"></iframe>
            </div>

            <!-- Карточка: Разработка (занимает 2 колонки из 6, то есть 33%) -->
            <a href="development.html" class="md:col-span-2 bg-white rounded-[2rem] p-8 shadow-sm metro-card flex flex-col justify-between group">
                <div>
                    <h2 class="text-xl font-black mb-4">Разработка</h2>
                    <p class="text-gray-500 text-sm leading-relaxed mb-6">
                        Узнайте больше о процессе создания нашей игры, технических деталях и текущем прогрессе строительства станций.
                    </p>
                </div>
                <div class="w-8 h-8 rounded-full bg-gray-100 flex items-center justify-center self-end arrow-icon transition-all">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                </div>
            </a>

            <!-- Карточка: Вакансии (занимает 2 колонки из 6, то есть 33%) -->
            <a href="vacancies.html" class="md:col-span-2 bg-white rounded-[2rem] p-8 shadow-sm metro-card flex flex-col justify-between group">
                <div>
                    <h2 class="text-xl font-black mb-4">Вакансии</h2>
                    <p class="text-gray-500 text-sm leading-relaxed mb-6">
                        Станьте частью команды BMP. Мы ищем талантливых строителей, скриптеров и дизайнеров для реализации проекта.
                    </p>
                </div>
                <div class="w-8 h-8 rounded-full bg-gray-100 flex items-center justify-center self-end arrow-icon transition-all">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                </div>
            </a>

            <!-- Карточка: Ссылки (занимает 2 колонки из 6, то есть 33%) -->
            <a href="links.html" class="md:col-span-2 bg-white rounded-[2rem] p-8 shadow-sm metro-card flex flex-col justify-between group">
                <div>
                    <h2 class="text-xl font-black mb-4">Ссылки</h2>
                    <p class="text-gray-500 text-sm leading-relaxed mb-6">
                        Полезные ресурсы, социальные сети проекта и ссылки на официальную документацию.
                    </p>
                </div>
                <div class="w-8 h-8 rounded-full bg-gray-100 flex items-center justify-center self-end arrow-icon transition-all">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                </div>
            </a>

        </div>
    </main>

    <footer class="w-full bg-white border-t border-gray-100 py-6 px-8 flex flex-col md:flex-row justify-between items-center gap-4 text-gray-400">
        <div class="font-light text-sm tracking-wide text-gray-500 uppercase">BMP METRO PROJECT 2026</div>
        <div class="text-sm">
            <span class="font-light text-gray-500">Контакты:</span> 
            <a href="mailto:workerowerk@gmail.com" class="font-bold text-gray-900 hover:text-red-500 transition-colors ml-1">workerowerk@gmail.com</a>
        </div>
    </footer>

    <script>
        const observer = new IntersectionObserver((entries, obs) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) { 
                    entry.target.classList.add('visible');
                    obs.unobserve(entry.target); 
                }
            });
        }, { threshold: 0.1 });
        document.querySelectorAll('.fade-up').forEach(el => observer.observe(el));
    </script>
</body>
</html>
